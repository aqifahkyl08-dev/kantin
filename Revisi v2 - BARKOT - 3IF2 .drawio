        <mxCell id="vc0y_Iv7zo9k1i1C2Avo-41" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=11;" value="AmbilPesananTerlama()&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Catatan : Mencari pesanan paling awal yang belum Selesai (FIFO); dipakai oleh TampilkanAntrean() dan UbahStatus()&lt;/div&gt;" vertex="1">
          <mxGeometry height="85" width="290" x="804.1000244021416" y="429.4000244140625" as="geometry" />
