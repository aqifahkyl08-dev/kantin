        <mxCell id="vc0y_Iv7zo9k1i1C2Avo-38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=11;" value="Item" vertex="1">
          <mxGeometry height="60" width="110" x="56.60002440214157" y="229.4000244140625" as="geometry" />
