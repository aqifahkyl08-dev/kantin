        <mxCell id="vc0y_Iv7zo9k1i1C2Avo-42" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=11;" value="UbahStatus()&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Catatan : Status pesanan terlama (dari AmbilPesananTerlama()) naik 1 tahap: Diproses -&gt; Siap Diambil -&gt; Selesai; pesan siap diambil/selesai langsung ditampilkan di dalam fungsi ini&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="290" x="770.0000244021415" y="544.4000244140625" as="geometry" />
        </mxCell>
