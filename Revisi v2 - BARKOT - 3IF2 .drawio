        <mxCell id="vc0y_Iv7zo9k1i1C2Avo-53" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;" value="&lt;font&gt;&lt;span style=&quot;text-align: center;&quot;&gt;Pembeli dilayani berdasarkan urutan datang (FIFO: First In First Out).&lt;/span&gt;&lt;br style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;text-align: center;&quot;&gt;Setiap pembeli otomatis mendapat nomor antrean dan disimpan dalam array&lt;/span&gt;&lt;br style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;text-align: center;&quot;&gt;di posisi paling belakang; pesanan diproses dari indeks terkecil yang belum Selesai.&lt;/span&gt;&lt;/font&gt;" vertex="1">
