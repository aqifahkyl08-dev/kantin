        <mxCell id="vc0y_Iv7zo9k1i1C2Avo-45" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=11;" value="CatatPesanan()&lt;div&gt;1. Input nama pembeli&lt;/div&gt;&lt;div&gt;2. Pilih menu dan jumlah (bisa ditambah lagi: Tambah menu lagi (y/n)?)&lt;/div&gt;&lt;div&gt;3. Nomor antrean dan total harga&lt;/div&gt;&lt;div&gt;&lt;br&gt;Catatan : satu fungsi untuk seluruh proses pencatatan (tidak ada fungsi lain di dalamnya); nama diulang sampai tidak kosong, menu dan jumlah diulang jika tidak valid; jawaban y menambah menu ke pesanan yang sama, jawaban selain y/n diulang; total harga = jumlah (harga x jumlah) semua menu; nomor antrean = jumlahPesanan + 1, status awal &quot;Diproses&quot;; lalu nomor antrean dan total harga ditampilkan&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="330" x="804.1000244021416" y="-35.5999755859375" as="geometry" />
        </mxCell>
        <mxCell id="vc0y_Iv7zo9k1i1C2Avo-46" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=11;" value="Dihitung langsung di dalam CatatPesanan()&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;totalHarga = harga x jumlah, tiap menu dijumlahkan&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Catatan : Sistem menghitung secara otomatis&lt;/div&gt;" vertex="1">
